_anio":{"2014":"elecciones europeas de 2014","2019":"elecciones europeas de 2019","2024":"elecciones europeas de 2024"},"fuentes_anio":{"2014":["MIR_RESULTADOS_ELECTORALES_MUNICIPALES"],"2019":["MIR_RESULTADOS_ELECTORALES_MUNICIPALES"],"2024":["MIR_RESULTADOS_ELECTORALES_MUNICIPALES"]}}