a","sdet":"el Nomenclátor de ese año trae el total del municipio, pero no el detalle de núcleos y diseminado; no es un cero","nf":"el fichero oficial de esa elección no trae este municipio; no es un cero","nx":"sin resultado propio en esa elección: la fuente da sus votos junto con los de otro municipio (véase el municipio histórico)","u1900":"en 1900 formaba parte de un ayuntamiento mayor: su cifra va en el municipio histórico de 1900","dud":"la cifra de 1900 de su ayuntamiento está en duda (las lecturas de la fuente no coinciden) y no entra; no es un cero"},"q":["","","","","","",""],"origen_nivel_anio":{"1987":"suma_municipios_hoy","1989":"suma_municipios_hoy","1994":"suma_municipios_hoy","1999":"suma_municipios_hoy","2004":"suma_municipios_hoy","2009":"suma_municipios_hoy","2014":"suma_municipios_hoy"},"origen_nivel":"suma_municipios_hoy","notas_anio":{"1987":"elecciones europeas de 1987","1989":"elecciones europeas de 1989","1994":"elecciones europeas de 1994","1999":"elecciones europeas de 1999","2004":"elecciones europeas de 2004","2009":"elecciones europeas de 2009","2014":"elecciones europeas de 2014"},"fuentes_anio":{"1987":["MIR_RESULTADOS_ELECTORALES_MUNICIPALES"],"1989":["MIR_RESULTADOS_ELECTORALES_MUNICIPALES"],"1994":["MIR_RESULTADOS_ELECTORALES_MUNICIPALES"],"1999":["MIR_RESULTADOS_ELECTORALES_MUNICIPALES"],"2004":["MIR_RESULTADOS_ELECTORALES_MUNICIPALES"],"2009":["MIR_RESULTADOS_ELECTORALES_MUNICIPALES"],"2014":["MIR_RESULTADOS_ELECTORALES_MUNICIPALES"]}}